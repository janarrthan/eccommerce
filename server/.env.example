NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://eccommerce:eccommerce@localhost:5433/eccommerce?schema=public
TRUST_PROXY_HOPS=1
SESSION_COOKIE_SAME_SITE=lax

# Start this disposable PostgreSQL instance with ../docker-compose.test.yml.
# Integration tests use only this URL and never fall back to DATABASE_URL.
# The database name must include a separate test token, such as eccommerce_test.
TEST_DATABASE_URL=postgresql://eccommerce_test:eccommerce_test@localhost:5434/eccommerce_test

# Use Stripe test mode only.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_URL=http://localhost:5173/checkout/success
STRIPE_CANCEL_URL=http://localhost:5173/cart
